{
  "name": "laingify",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "seed:demo": "node prisma/seed.mjs",
    "seed:camp": "node prisma/seed-camp.mjs",
    "seed:abaco": "node prisma/seed-abaco.mjs",
    "content:update": "node prisma/seed-abaco.mjs --update",
    "seed:kcsb": "node prisma/seed-kcsb.mjs",
    "content:update:kcsb": "node prisma/seed-kcsb.mjs --update",
    "digest": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/weekly-digest.mjs",
    "report:term": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/term-report.mjs",
    "export:work": "node --env-file=.env --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-student-work.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/three": "^0.185.3",
    "@wokwi/elements": "^1.9.2",
    "avr8js": "^0.21.0",
    "clsx": "^2.1.1",
    "motion": "^12.41.0",
    "next": "16.2.9",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "scratchblocks": "^3.7.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
